{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Enterprise workspace user account carrying multi-tenant business association and RBAC roles.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { 
          "type": "string",
          "enum": ["MASTER_ADMIN", "BUSINESS_ADMIN", "STAFF"]
        },
        "businessId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["ACTIVE", "DEACTIVATED"] }
      },
      "required": ["id", "email", "role", "businessId"]
    },
    "Quotation": {
      "title": "Sales Quotation",
      "description": "Commercial proposal for services or products scoped to a single tenant business.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "quoteNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["DRAFT", "SENT", "ACCEPTED", "REJECTED"] }
      },
      "required": ["id", "businessId", "quoteNumber", "clientName", "total"]
    },
    "Invoice": {
      "title": "Tax Invoice",
      "description": "Tax-compliant invoice scoped to a single tenant business.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["UNPAID", "PAID", "OVERDUE"] }
      },
      "required": ["id", "businessId", "invoiceNumber", "clientName", "total"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User accounts with system roles and company tenant mappings."
    },
    "companies/{companyId}/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Sales proposals belonging to a specific company."
    },
    "companies/{companyId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Tax invoices belonging to a specific company."
    }
  }
}
