{
  "entities": {
    "Company": {
      "title": "Company Settings",
      "description": "Information about the registered company including its base64 letterhead logo.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "UID of the owner user." },
        "name": { "type": "string", "description": "Legal company name." },
        "email": { "type": "string", "description": "Company email address." },
        "phone": { "type": "string", "description": "Company contact number." },
        "address": { "type": "string", "description": "Physical company address." },
        "letterheadLogo": { "type": "string", "description": "Base64 or URL data of the company logo." },
        "logo": { "type": "string", "description": "Base64 or URL data of the company logo." },
        "favicon": { "type": "string", "description": "Base64 or URL data of the favicon / icon." },
        "primaryColor": { "type": "string", "description": "Primary color code (HEX)." },
        "secondaryColor": { "type": "string", "description": "Secondary color code (HEX)." },
        "useCompanyLetterhead": { "type": "boolean", "description": "Whether to use company letterhead spanning the full top of invoice or quotation." },
        "themePreset": { "type": "string", "description": "Preset theme key (e.g. default, emerald, violet, crimson, etc.)." },
        "themeMode": { "type": "string", "description": "Theme canvas mode: light, warm, dim, dark." },
        "fontFamily": { "type": "string", "description": "Selected Google font family pairing." },
        "cardRadius": { "type": "string", "description": "Theme card border radius: none, md, lg, xl, full." },
        "sidebarStyle": { "type": "string", "description": "Navigation bar visual theme: flat, colored, gradient, bordered." }
      },
      "required": ["ownerId", "name"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Quotation details containing items and client address.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "number": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientAddress": { "type": "string" },
        "date": { "type": "string" },
        "validUntil": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] }
      },
      "required": ["ownerId", "number", "clientName", "total", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Corporate invoice representing billable items.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "number": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientAddress": { "type": "string" },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["unpaid", "paid", "overdue"] }
      },
      "required": ["ownerId", "number", "clientName", "total", "status"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Payment receipt proving invoices were settled.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "number": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "refunded"] }
      },
      "required": ["ownerId", "number", "clientName", "amount", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification dispatch for a business tenant.",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] }
      },
      "required": ["businessId", "title", "message", "read"]
    },
    "Task": {
      "title": "Task",
      "description": "A project task.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["todo", "in-progress", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "createdAt": { "type": "string" }
      },
      "required": ["ownerId", "title", "status", "priority", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A business project.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["planning", "in-progress", "completed", "on-hold"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "clientId": { "type": "string" },
        "budget": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["ownerId", "name", "status", "startDate", "budget", "createdAt"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Company registration directory."
    },
    "/companies/{companyId}/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Quotations sub-directory."
    },
    "/companies/{companyId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices sub-directory."
    },
    "/companies/{companyId}/receipts/{receiptId}": {
      "schema": "Receipt",
      "description": "Receipts sub-directory."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System or tenant event notifications."
    },
    "/companies/{companyId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Project tasks sub-directory."
    },
    "/companies/{companyId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Project management directory."
    }
  }
}
