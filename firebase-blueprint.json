{
  "entities": {
    "Company": {
      "title": "Company Settings",
      "description": "Information about the registered company including its base64 letterhead logo.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "UID of the owner user." },
        "name": { "type": "string", "description": "Legal company name." },
        "email": { "type": "string", "description": "Company email address." },
        "phone": { "type": "string", "description": "Company contact number." },
        "address": { "type": "string", "description": "Physical company address." },
        "letterheadLogo": { "type": "string", "description": "Base64 or URL data of the company logo." },
        "logo": { "type": "string", "description": "Base64 or URL data of the company logo." },
        "favicon": { "type": "string", "description": "Base64 or URL data of the favicon / icon." },
        "primaryColor": { "type": "string", "description": "Primary color code (HEX)." },
        "secondaryColor": { "type": "string", "description": "Secondary color code (HEX)." },
        "useCompanyLetterhead": { "type": "boolean", "description": "Whether to use company letterhead spanning the full top of invoice or quotation." },
        "themePreset": { "type": "string", "description": "Preset theme key (e.g. default, emerald, violet, crimson, etc.)." },
        "themeMode": { "type": "string", "description": "Theme canvas mode: light, warm, dim, dark." },
        "fontFamily": { "type": "string", "description": "Selected Google font family pairing." },
        "cardRadius": { "type": "string", "description": "Theme card border radius: none, md, lg, xl, full." },
        "sidebarStyle": { "type": "string", "description": "Navigation bar visual theme: flat, colored, gradient, bordered." },
        "isVerified": { "type": "boolean", "description": "Verification status of the company (defaults to false until verified by 6-digit corporate OTP)." },
        "isEmailVerified": { "type": "boolean", "description": "Whether the primary administrator corporate email has been validated." },
        "verifiedEmail": { "type": "string", "description": "The exact verified corporate email address." },
        "emailVerifiedAt": { "type": "string", "description": "ISO timestamp of when the corporate email was verified." },
        "subscriptionPlanId": { "type": "string", "description": "Active subscription tier identifier (starter, growth, professional, elite, enterprise)." },
        "subscriptionPlan": { "type": "string", "description": "Human-readable active subscription plan name." },
        "subscriptionStatus": { "type": "string", "description": "Status of the subscription (e.g. active, trialing, expired)." }
      },
      "required": ["ownerId", "name"]
    },
    "PurchaseRequest": {
      "title": "Purchase Request",
      "description": "Internal request for procurement.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "prNumber": { "type": "string" },
        "requestedBy": { "type": "string" },
        "items": { "type": "array" },
        "status": { "type": "string", "enum": ["Draft", "Pending", "Approved", "Rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["ownerId", "prNumber", "requestedBy", "items", "status", "createdAt"]
    },
    "RFQ": {
      "title": "Request for Quotation",
      "description": "RFQ sent to suppliers.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "rfqNumber": { "type": "string" },
        "supplierIds": { "type": "array" },
        "items": { "type": "array" },
        "status": { "type": "string", "enum": ["Open", "Closed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["ownerId", "rfqNumber", "supplierIds", "items", "status", "createdAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Vendor contact details, credit terms, and lead times.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "creditTerms": { "type": "string" },
        "leadTime": { "type": "number" }
      },
      "required": ["ownerId", "name"]
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "description": "Incoming request for goods or services.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "poNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Pending", "Approved", "Sent"] },
        "deliveryDate": { "type": "string" }
      },
      "required": ["ownerId", "poNumber", "supplierId", "totalAmount", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Supplier invoice for goods or services.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "poNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Unpaid", "Paid"] }
      },
      "required": ["ownerId", "poNumber", "supplierId", "totalAmount", "status"]
    },
    "GoodsReceived": {
      "title": "Goods Received",
      "description": "Goods received record from a supplier.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "poNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "items": { "type": "array" },
        "receivedDate": { "type": "string" }
      },
      "required": ["ownerId", "poNumber", "supplierId", "receivedDate"]
    },
    "POSSale": {
      "title": "POS Sale",
      "description": "Walk-in customer sale record.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["ownerId", "items", "totalAmount", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification dispatch for a business tenant.",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] }
      },
      "required": ["businessId", "title", "message", "read"]
    },
    "Task": {
      "title": "Task",
      "description": "A project task.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["todo", "in-progress", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "projectId": { "type": "string", "description": "Associated project ID." },
        "departmentId": { "type": "string", "description": "Associated department ID." },
        "assignedEmployeeId": { "type": "string", "description": "ID of the assigned employee." },
        "createdAt": { "type": "string" }
      },
      "required": ["ownerId", "title", "status", "priority", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A business project.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "departmentId": { "type": "string", "description": "Associated department ID." },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["planning", "in-progress", "completed", "on-hold"] },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "clientId": { "type": "string" },
        "budget": { "type": "number" },
        "createdAt": { "type": "string" },
        "completedTaskCount": { "type": "number" },
        "totalTaskCount": { "type": "number" },
        "budgetUsed": { "type": "number" },
        "lastUpdatedAt": { "type": "string" }
      },
      "required": ["ownerId", "name", "status", "startDate", "budget", "createdAt"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "A customer support ticket.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "resolved", "closed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "createdAt": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" }
      },
      "required": ["ownerId", "title", "status", "priority", "createdAt"]
    },
    "LegalDocument": {
      "title": "Legal Document",
      "description": "Dynamic legal and compliance documents with version history.",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "currentVersion": { "type": "string" },
        "effectiveDate": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "versions": { "type": "array" },
        "requiresReconsent": { "type": "boolean" },
        "jurisdictionNotice": { "type": "string" },
        "applicableLaw": { "type": "string" },
        "publishedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "slug", "currentVersion", "effectiveDate", "content"]
    },
    "Department": {
      "title": "Department",
      "description": "HR and Operations department definition.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "totalCapacity": { "type": "number" },
        "assignedBudget": { "type": "number" }
      },
      "required": ["companyId", "name", "totalCapacity", "assignedBudget"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "Marketing campaign definition.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "channel": { "type": "string" },
        "utmSource": { "type": "string" },
        "utmMedium": { "type": "string" },
        "utmCampaign": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] }
      },
      "required": ["companyId", "channel", "utmSource", "utmMedium", "utmCampaign", "createdAt", "status"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Captured lead from a campaign.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "campaignId": { "type": "string" },
        "postId": { "type": "string" },
        "sourcePlatform": { "type": "string" },
        "conversionType": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["companyId", "campaignId", "sourcePlatform", "conversionType", "timestamp"]
    },
    "EmailPreference": {
      "title": "Email Preference",
      "description": "Customer communication preferences and marketing opt-out settings.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "userId": { "type": "string" },
        "companyId": { "type": "string" },
        "marketingEnabled": { "type": "boolean" },
        "productUpdatesEnabled": { "type": "boolean" },
        "newsletterEnabled": { "type": "boolean" },
        "featureAnnouncementsEnabled": { "type": "boolean" },
        "educationalContentEnabled": { "type": "boolean" },
        "promotionalOffersEnabled": { "type": "boolean" },
        "unsubscribedAt": { "type": "string" },
        "unsubscribeSource": { "type": "string" },
        "consentTimestamp": { "type": "string" },
        "consentSource": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "marketingEnabled", "updatedAt"]
    },
    "EmailAuditLog": {
      "title": "Email Audit Log",
      "description": "Immutable ledger of unsubscribe events, preference updates, and pre-send block decisions.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "action": { "type": "string" },
        "preferenceCategory": { "type": "string" },
        "source": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["email", "action", "timestamp", "source"]
    },
    "SubscriptionEmailEvent": {
      "title": "Subscription Email Event",
      "description": "Idempotent transactional email delivery record for subscription events.",
      "type": "object",
      "properties": {
        "emailType": { "type": "string" },
        "companyId": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "deliveryStatus": { "type": "string", "enum": ["SENT", "FAILED", "PENDING", "BLOCKED"] },
        "providerMessageId": { "type": "string" },
        "timestamp": { "type": "string" },
        "retryCount": { "type": "number" }
      },
      "required": ["emailType", "companyId", "recipientEmail", "deliveryStatus", "timestamp"]
    },
    "User": {
      "title": "Workspace User Profile",
      "description": "User identity and workspace profile record, including avatar/profile photo.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "businessId": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "positionTitle": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string", "description": "Profile photo stored as optimized Base64 data URI or image URL." },
        "profilePic": { "type": "string", "description": "Workspace profile avatar image." },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Workspace user directory with profile and avatar image."
    },
    "/subscription_email_events/{eventId}": {
      "schema": "SubscriptionEmailEvent",
      "description": "Audit and idempotency ledger for subscription lifecycle transactional emails."
    },
    "/email_preferences/{prefId}": {
      "schema": "EmailPreference",
      "description": "Customer email preference directory."
    },
    "/email_audit_logs/{logId}": {
      "schema": "EmailAuditLog",
      "description": "Statutory email audit logs."
    },
    "/legal_documents/{docId}": {
      "schema": "LegalDocument",
      "description": "Public and dynamic legal compliance documents registry."
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Company registration directory."
    },
    "/companies/{companyId}/purchase_requests/{prId}": {
      "schema": "PurchaseRequest",
      "description": "Purchase requests sub-directory."
    },
    "/companies/{companyId}/rfqs/{rfqId}": {
      "schema": "RFQ",
      "description": "RFQs sub-directory."
    },
    "/companies/{companyId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Suppliers sub-directory."
    },
    "/companies/{companyId}/purchase_orders/{poId}": {
      "schema": "PurchaseOrder",
      "description": "Purchase Orders sub-directory."
    },
    "/companies/{companyId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices sub-directory."
    },
    "/companies/{companyId}/goods_received/{grnId}": {
      "schema": "GoodsReceived",
      "description": "Goods Received sub-directory."
    },
    "/companies/{companyId}/pos_sales/{saleId}": {
      "schema": "POSSale",
      "description": "POS sales sub-directory."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System or tenant event notifications."
    },
    "/companies/{companyId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Project tasks sub-directory."
    },
    "/companies/{companyId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Project management directory."
    },
    "/companies/{companyId}/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets sub-directory."
    },
    "/companies/{companyId}/departments/{departmentId}": {
      "schema": "Department",
      "description": "Departments sub-directory."
    },
    "/companies/{companyId}/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Marketing campaigns for a company."
    },
    "/companies/{companyId}/leads/{leadId}": {
      "schema": "Lead",
      "description": "Leads generated by campaigns."
    }
  }
}
