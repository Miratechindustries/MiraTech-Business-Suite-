rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PRINCIPLE 1: Default-Deny Access Control (Zero Trust Firewall)
    // Global lock: explicitly block any unrouted access or wildcard paths. No
    // client can query or read documents unless explicitly allowed in sub-rules.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRINCIPLE 2: Cryptographic Identity & Active Session Validation (Authentication)
    // Ensures that only validated sessions are capable of traversing rules.
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isMiratechEmail() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)miratechindustries@gmail.com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '').matches('(?i)miratechindustries@gmail.com'))
      );
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        isMiratechEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF').matches('(?i)MASTER_ADMIN'))
      );
    }

    // =========================================================================
    // PRINCIPLE 3 & 4: Tenant Boundary Isolation & Role-Based Least Privilege (RBAC Engine)
    // Validates that standard administrators can only read/edit their assigned core profiles.
    // =========================================================================
    function isAuthorizedAdminForCompany(companyId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == companyId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF').matches('(?i)(BUSINESS_ADMIN|BUSINESS-ADMIN|BUSINESS ADMIN)') && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == companyId ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
          )
        )
      );
    }

    // =========================================================================
    // PATH SEGMENTATION: Companies & Nested Subcollections
    // =========================================================================
    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.token.email == 'miratechindustries@gmail.com' ||
        request.auth.uid == companyId ||
        isAuthorizedAdminForCompany(companyId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == companyId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
        ))
      );
      
      allow write: if isAuthorizedAdminForCompany(companyId);
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn() && (
          isMasterAdmin() ||
          request.auth.uid == companyId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == companyId ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
          ))
        );
        
        allow write: if isSignedIn() && (
          isMasterAdmin() ||
          request.auth.uid == companyId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == companyId ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
          ))
        );
      }
    }

    match /businesses/{businessId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == businessId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == businessId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == businessId
        ))
      );
      
      allow write: if isAuthorizedAdminForCompany(businessId);
    }

    // =========================================================================
    // PRINCIPLE 7: Privilege Escalation Prevention & Anti-Tampering (Defense-in-depth)
    // Block standard users from promoting their own security context or changing tenants.
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isMasterAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == resource.data.get('businessId', resource.data.get('companyId', '')) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == resource.data.get('businessId', resource.data.get('companyId', ''))
        ))
      );
      
      allow create: if isSignedIn() && (
        request.auth.uid == userId && (
          isMasterAdmin() || (
            request.resource.data.get('role', 'STAFF').matches('(?i)STAFF')
          )
        ) ||
        isMasterAdmin()
      );
      
      allow update: if isSignedIn() && (
        request.auth.uid == userId && (
          isMasterAdmin() || (
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.get('role', 'STAFF') == resource.data.get('role', 'STAFF')) &&
            (!request.resource.data.keys().hasAny(['businessId']) || request.resource.data.get('businessId', '') == resource.data.get('businessId', '')) &&
            (!request.resource.data.keys().hasAny(['companyId']) || request.resource.data.get('companyId', '') == resource.data.get('companyId', ''))
          )
        ) || 
        isMasterAdmin()
      );
      
      allow delete: if isSignedIn() && isMasterAdmin();
    }

    // =========================================================================
    // PRINCIPLE 5: Non-Repudiation Immutable Logging (Auditing Firewall)
    // Strictly write-once/append-only. Nobody can delete or tamper with audit records.
    // =========================================================================
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && (
        isMasterAdmin() ||
        resource.data.get('businessId', '') == request.auth.uid ||
        resource.data.get('companyId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );

      allow list: if isSignedIn() && (
        isMasterAdmin() ||
        resource.data.get('businessId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );
      
      allow create: if isSignedIn() && (
        isMasterAdmin() ||
        request.resource.data.get('businessId', '') == request.auth.uid ||
        request.resource.data.get('companyId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          request.resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          request.resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') ||
          request.resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          request.resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );
      
      allow update, delete: if false;
    }

    // =========================================================================
    // PRINCIPLE 6: Deep Content & Payload Schema Inspection
    // Enforcing required tenant structures on insertions to block malformed/orphan injections.
    // =========================================================================
    match /{collectionName}/{docId} {
      allow get: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        isMasterAdmin() ||
        resource.data.get('businessId', '') == request.auth.uid ||
        resource.data.get('companyId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );

      allow list: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        isMasterAdmin() ||
        resource.data.get('businessId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );

      allow create, update: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        (request.resource.data.get('businessId', '') != '' || request.resource.data.get('companyId', '') != '') &&
        (
          isMasterAdmin() ||
          request.resource.data.get('businessId', '') == request.auth.uid ||
          request.resource.data.get('companyId', '') == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            request.resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
            request.resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') ||
            request.resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
            request.resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
          ))
        )
      );

      allow delete: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        isMasterAdmin() ||
        resource.data.get('businessId', '') == request.auth.uid ||
        resource.data.get('companyId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );
    }
  }
}
