rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Company registration collection
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().ownerId) && isValidId(companyId);
      allow update: if isSignedIn() && isOwner(existing().ownerId) && isOwner(incoming().ownerId);
      allow delete: if isSignedIn() && isOwner(existing().ownerId);

      // Quotations sub-collection
      match /quotations/{quotationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isOwner(incoming().ownerId) && isValidId(quotationId);
        allow update: if isSignedIn() && isOwner(existing().ownerId) && isOwner(incoming().ownerId);
        allow delete: if isSignedIn() && isOwner(existing().ownerId);
      }

      // Invoices sub-collection
      match /invoices/{invoiceId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isOwner(incoming().ownerId) && isValidId(invoiceId);
        allow update: if isSignedIn() && isOwner(existing().ownerId) && isOwner(incoming().ownerId);
        allow delete: if isSignedIn() && isOwner(existing().ownerId);
      }

      // Receipts sub-collection
      match /receipts/{receiptId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isOwner(incoming().ownerId) && isValidId(receiptId);
        allow update: if isSignedIn() && isOwner(existing().ownerId) && isOwner(incoming().ownerId);
        allow delete: if isSignedIn() && isOwner(existing().ownerId);
      }
    }
  }
}
