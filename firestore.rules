rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Strictly Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isMiratechEmail() {
      return isSignedIn() && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'miratechindustries@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == 'miratechindustries@gmail.com')
      );
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        isMiratechEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'MASTER_ADMIN')
      );
    }

    function isAuthorizedAdminForCompany(companyId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == companyId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'BUSINESS_ADMIN' || 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'Business Admin' || 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'business_admin' || 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'business admin' || 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'Business_Admin' || 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'BUSINESS-ADMIN' || 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'business-admin' || 
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF') == 'Business-Admin'
          ) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == companyId ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
          )
        )
      );
    }

    // --- Collections ---

    // 1. Companies & Nested subcollections (Quotation, Invoice, Receipt)
    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == companyId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == companyId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
        ))
      );
      
      allow write: if isAuthorizedAdminForCompany(companyId);
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn() && (
          isMasterAdmin() ||
          request.auth.uid == companyId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == companyId ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
          ))
        );
        
        allow write: if isSignedIn() && (
          isMasterAdmin() ||
          request.auth.uid == companyId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == companyId ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == companyId
          ))
        );
      }
    }

    // 2. Businesses
    match /businesses/{businessId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == businessId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == businessId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == businessId
        ))
      );
      
      allow write: if isAuthorizedAdminForCompany(businessId);
    }

    // 3. Users (Individual profile)
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isMasterAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') == resource.data.get('businessId', resource.data.get('companyId', '')) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') == resource.data.get('businessId', resource.data.get('companyId', ''))
        ))
      );
      allow create, update: if isSignedIn() && (
        request.auth.uid == userId || 
        isMasterAdmin()
      );
      allow delete: if isSignedIn() && isMasterAdmin();
    }

    // 4. Multi-tenant flat collections (Expenses, Customers, Products, Audit Logs, etc.)
    match /{collectionName}/{docId} {
      allow read: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'audit_logs', 'notifications', 'general_ledger', 'journal_entries']) && (
        isMasterAdmin() ||
        resource.data.get('businessId', '') == request.auth.uid ||
        resource.data.get('companyId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );

      allow create, update: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'audit_logs', 'notifications', 'general_ledger', 'journal_entries']) && (
        isMasterAdmin() ||
        request.resource.data.get('businessId', '') == request.auth.uid ||
        request.resource.data.get('companyId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          request.resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          request.resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') ||
          request.resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          request.resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );

      allow delete: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'audit_logs', 'notifications', 'general_ledger', 'journal_entries']) && (
        isMasterAdmin() ||
        resource.data.get('businessId', '') == request.auth.uid ||
        resource.data.get('companyId', '') == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('businessId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', '') ||
          resource.data.get('companyId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', '')
        ))
      );
    }
  }
}
