rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // GLOBAL HELPERS
    // ---------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getBusinessId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('businessId', null) : null;
    }
    
    function isBusinessOwner(businessId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/businesses/$(businessId)) && 
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    function isBusinessMember(businessId) {
      return isSignedIn() && (getBusinessId() == businessId || isBusinessOwner(businessId));
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'miratechindustries@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STAFF').upper() == 'MASTER_ADMIN')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // MASTER ADMIN OVERSIGHT
    // ---------------------------------------------------------
    match /transactions/{id} {
      allow read, write: if isMasterAdmin();
    }
    match /audit_logs/{id} {
      allow read, write: if isMasterAdmin();
    }
    match /auditLogs/{id} {
      allow read, write: if isMasterAdmin();
    }

    // ---------------------------------------------------------
    // USERS
    // ---------------------------------------------------------
    
    match /users/{userId} {
      allow list: if isSignedIn() && isMasterAdmin();
      allow get: if isOwner(userId) || isMasterAdmin();
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['uid', 'email', 'businessId']) && 
        incoming().uid == userId;
      allow update: if (isOwner(userId) || isMasterAdmin()) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'role', 'status', 'accessExpiryDate', 'businessId']);
    }

    // ---------------------------------------------------------
    // BUSINESSES
    // ---------------------------------------------------------
    
    match /businesses/{businessId} {
      allow get: if isSignedIn() && (isBusinessMember(businessId) || isMasterAdmin());
      allow list: if isSignedIn() && (isMasterAdmin() || resource.data.adminEmail == request.auth.token.email);
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isMasterAdmin());
      allow update: if (isBusinessOwner(businessId) || isMasterAdmin()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone', 'address', 'currency', 'updatedAt', 'status']);
    }

    // ---------------------------------------------------------
    // SUB-COLLECTIONS (Scoped to Business)
    // ---------------------------------------------------------
    
    match /businesses/{businessId}/{allSubcollections=**} {
      allow read, write: if isBusinessMember(businessId) || isMasterAdmin();
    }

    // ---------------------------------------------------------
    // SYSTEM TRACKING
    // ---------------------------------------------------------
    
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.businessId == getBusinessId() || isMasterAdmin());
    }

    match /auditLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.businessId == getBusinessId() || isMasterAdmin());
    }

    // ---------------------------------------------------------
    // SUBSCRIPTIONS & PLANS
    // ---------------------------------------------------------
    
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.businessId != null && isBusinessMember(resource.data.businessId) || isMasterAdmin());
      allow write: if isMasterAdmin();
    }

    // ---------------------------------------------------------
    // NOTIFICATIONS
    // ---------------------------------------------------------
    
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isMasterAdmin());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
        incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
