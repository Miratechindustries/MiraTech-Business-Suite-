rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'miratechindustries@gmail.com' ||
        request.auth.token.role == 'MASTER_ADMIN'
      );
    }

    function verifyTenant(companyId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.token.companyId == companyId ||
        request.auth.token.businessId == companyId ||
        request.auth.uid == companyId
      );
    }

    function verifyResourceTenant() {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.token.companyId == resource.data.companyId ||
        request.auth.token.companyId == resource.data.businessId ||
        request.auth.token.businessId == resource.data.companyId ||
        request.auth.token.businessId == resource.data.businessId ||
        resource.data.companyId == request.auth.uid ||
        resource.data.businessId == request.auth.uid
      );
    }

    function verifyCreationTenant() {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.token.companyId == request.resource.data.companyId ||
        request.auth.token.companyId == request.resource.data.businessId ||
        request.auth.token.businessId == request.resource.data.companyId ||
        request.auth.token.businessId == request.resource.data.businessId ||
        request.resource.data.companyId == request.auth.uid ||
        request.resource.data.businessId == request.auth.uid
      );
    }

    // Companies & Subcollections
    match /companies/{companyId} {
      allow read, write: if verifyTenant(companyId);

      match /{subcollection}/{docId} {
        allow read: if verifyTenant(companyId) && (verifyResourceTenant() || true);
        allow create: if verifyTenant(companyId) && verifyCreationTenant();
        allow update: if verifyTenant(companyId) && verifyResourceTenant() && verifyCreationTenant();
        allow delete: if verifyTenant(companyId) && verifyResourceTenant();
      }
    }

    match /businesses/{businessId} {
      allow read, write: if verifyTenant(businessId);
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == userId ||
        request.auth.token.companyId == resource.data.companyId ||
        request.auth.token.businessId == resource.data.businessId ||
        resource.data.companyId == request.auth.uid
      );
      allow create, update: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == userId
      );
      allow delete: if isMasterAdmin();
    }

    // Audit logs (Append only, strict tenant match)
    match /audit_logs/{logId} {
      allow read: if verifyResourceTenant();
      allow create: if verifyCreationTenant();
      allow update, delete: if false;
    }

    // Root collections
    match /{collectionName}/{docId} {
      allow read: if verifyResourceTenant();
      allow create, update: if verifyCreationTenant();
      allow delete: if verifyResourceTenant();
    }
  }
}
