rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PRINCIPLE 1: Default-Deny Access Control (Zero Trust Firewall)
    // Global lock: explicitly block any unrouted access or wildcard paths. No
    // client can query or read documents unless explicitly allowed in sub-rules.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRINCIPLE 2: Cryptographic Identity & Active Session Validation (Authentication)
    // Ensures that only validated sessions are capable of traversing rules.
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data : 
        {'role': 'STAFF', 'businessId': request.auth.uid, 'companyId': request.auth.uid};
    }
    
    function isMiratechEmail() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'miratechindustries@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().email == 'miratechindustries@gmail.com')
      );
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        isMiratechEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'MASTER_ADMIN')
      );
    }

    // =========================================================================
    // PRINCIPLE 3 & 4: Tenant Boundary Isolation & Role-Based Least Privilege (RBAC Engine)
    // Validates that standard administrators can only read/edit their assigned core profiles.
    // =========================================================================
    function isAuthorizedAdminForCompany(companyId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == companyId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          (getUserData().role == 'BUSINESS_ADMIN' || getUserData().role == 'BUSINESS-ADMIN' || getUserData().role == 'BUSINESS ADMIN') && (
            getUserData().businessId == companyId ||
            getUserData().companyId == companyId
          )
        ))
      );
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == companyId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().businessId == companyId ||
          getUserData().companyId == companyId
        ))
      );
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserData().role : 'STAFF';
    }

    // =========================================================================
    // STATE MACHINE TRANSITION ENGINE (Invoices & Quotations Approval Engine)
    // Ensures that state changes follow strict, role-based transition parameters.
    // =========================================================================
    function isValidStateTransition(existingStatus, incomingStatus) {
      return (
        // No status change is always allowed
        existingStatus == incomingStatus ||
        
        // Draft/Rejected -> Pending Admin (Submit)
        ((existingStatus == 'draft' || existingStatus == 'rejected') && incomingStatus == 'pending_admin') ||
        
        // Pending Admin -> Pending HR (Forward to HR)
        (existingStatus == 'pending_admin' && incomingStatus == 'pending_hr' && (
          isMasterAdmin() || getUserRole() in ['DEPARTMENT_ADMIN', 'HR', 'BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'COMPANY_OWNER'] ||
          getUserData().approvalRights == true || getUserData().canApproveInvoices == true || getUserData().canApproveQuotations == true
        )) ||
        
        // Pending Admin -> Rejected (Return to Employee)
        (existingStatus == 'pending_admin' && incomingStatus == 'rejected' && (
          isMasterAdmin() || getUserRole() in ['DEPARTMENT_ADMIN', 'HR', 'BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'COMPANY_OWNER'] ||
          getUserData().approvalRights == true || getUserData().canApproveInvoices == true || getUserData().canApproveQuotations == true
        )) ||
        
        // Pending Admin -> Cancelled (Cancel Request)
        (existingStatus == 'pending_admin' && incomingStatus == 'cancelled' && (
          isMasterAdmin() || getUserRole() in ['DEPARTMENT_ADMIN', 'HR', 'BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'COMPANY_OWNER'] ||
          getUserData().approvalRights == true || getUserData().canApproveInvoices == true || getUserData().canApproveQuotations == true
        )) ||

        // Pending HR -> Pending Final (HR Approve)
        (existingStatus == 'pending_hr' && incomingStatus == 'pending_final' && (
          isMasterAdmin() || getUserRole() in ['HR', 'BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'COMPANY_OWNER'] ||
          getUserData().canOverrideHR == true || getUserData().approvalRights == true
        )) ||
        
        // Pending HR -> Rejected (HR Reject)
        (existingStatus == 'pending_hr' && incomingStatus == 'rejected' && (
          isMasterAdmin() || getUserRole() in ['HR', 'BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'COMPANY_OWNER'] ||
          getUserData().canOverrideHR == true || getUserData().approvalRights == true
        )) ||

        // Pending Final -> Approved (Final Approve)
        (existingStatus == 'pending_final' && incomingStatus == 'approved' && (
          isMasterAdmin() || getUserRole() in ['BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'FINANCE_MANAGER', 'OPERATIONS_MANAGER', 'MANAGING_DIRECTOR', 'COMPANY_OWNER'] ||
          getUserData().canFinalizeDocuments == true || getUserData().approvalRights == true
        )) ||
        
        // Pending Final -> Rejected (Reject & Return)
        (existingStatus == 'pending_final' && incomingStatus == 'rejected' && (
          isMasterAdmin() || getUserRole() in ['BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'FINANCE_MANAGER', 'OPERATIONS_MANAGER', 'MANAGING_DIRECTOR', 'COMPANY_OWNER'] ||
          getUserData().canFinalizeDocuments == true || getUserData().approvalRights == true
        )) ||
        
        // Manager Override: Direct Approve
        (existingStatus != 'approved' && incomingStatus == 'approved' && (
          isMasterAdmin() || getUserRole() in ['BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'COMPANY_OWNER'] ||
          getUserData().approvalRights == true
        ))
      );
    }

    function canUpdateDocument(companyId, existingData, incomingData) {
      return isMemberOfCompany(companyId) && (
        isMasterAdmin() || getUserRole() in ['BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'COMPANY_OWNER'] || getUserData().approvalRights == true || (
          // Staff cannot edit unless document is in draft or rejected status
          (getUserRole() != 'STAFF' || existingData.get('approvalStatus', 'approved') == 'draft' || existingData.get('approvalStatus', 'approved') == 'rejected') &&
          // Validate state transitions are authentic
          isValidStateTransition(existingData.get('approvalStatus', 'approved'), incomingData.get('approvalStatus', 'approved'))
        )
      );
    }

    function canDeleteDocument(companyId, existingData) {
      return isMemberOfCompany(companyId) && (
        isMasterAdmin() || getUserRole() in ['BUSINESS_ADMIN', 'MASTER_ADMIN', 'GENERAL_MANAGER', 'COMPANY_OWNER'] || getUserData().approvalRights == true || (
          // Staff/Clerks can only delete drafts or rejected files
          (existingData.get('approvalStatus', 'approved') == 'draft' || existingData.get('approvalStatus', 'approved') == 'rejected')
        )
      );
    }

    // =========================================================================
    // PATH SEGMENTATION: Companies & Nested Subcollections
    // =========================================================================
    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.token.email == 'miratechindustries@gmail.com' ||
        request.auth.uid == companyId ||
        isAuthorizedAdminForCompany(companyId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().businessId == companyId ||
          getUserData().companyId == companyId
        ))
      );
      
      allow write: if isAuthorizedAdminForCompany(companyId);
      
      // Nested Approval-Driven Collections:
      match /quotations/{quotationId} {
        allow read: if isMemberOfCompany(companyId);
        allow create: if isMemberOfCompany(companyId);
        allow update: if canUpdateDocument(companyId, resource.data, request.resource.data);
        allow delete: if canDeleteDocument(companyId, resource.data);
      }

      match /invoices/{invoiceId} {
        allow read: if isMemberOfCompany(companyId);
        allow create: if isMemberOfCompany(companyId);
        allow update: if canUpdateDocument(companyId, resource.data, request.resource.data);
        allow delete: if canDeleteDocument(companyId, resource.data);
      }

      match /receipts/{receiptId} {
        allow read: if isMemberOfCompany(companyId);
        allow write: if isMemberOfCompany(companyId);
      }

      match /supplier_quotations/{id} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /support_tickets/{ticketId} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /projects/{projectId} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /customers/{customerId} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /tasks/{taskId} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /department_activity_logs/{logId} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /analytics/{analyticsId} {
        allow read, write: if isMemberOfCompany(companyId);
      }

      match /purchase_requests/{id} {
        allow read, write: if isMemberOfCompany(companyId);
      }
      match /suppliers/{id} {
        allow read, write: if isMemberOfCompany(companyId);
      }
      match /rfqs/{id} {
        allow read, write: if isMemberOfCompany(companyId);
      }
      match /purchase_orders/{id} {
        allow read, write: if isMemberOfCompany(companyId);
      }
      match /goods_received/{id} {
        allow read, write: if isMemberOfCompany(companyId);
      }
      match /pos_sales/{id} {
        allow read, write: if isMemberOfCompany(companyId);
      }
      match /supplier_invoices/{id} {
        allow read, write: if isMemberOfCompany(companyId);
      }
    }

    match /businesses/{businessId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == businessId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().businessId == businessId ||
          getUserData().companyId == businessId
        ))
      );
      
      allow write: if isAuthorizedAdminForCompany(businessId);
    }

    // =========================================================================
    // PRINCIPLE 7: Privilege Escalation Prevention & Anti-Tampering (Defense-in-depth)
    // Block standard users from promoting their own security context or changing tenants.
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isMasterAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().businessId == resource.data.businessId ||
          getUserData().businessId == resource.data.companyId ||
          getUserData().companyId == resource.data.businessId ||
          getUserData().companyId == resource.data.companyId
        ))
      );
      
      allow create: if isSignedIn() && (
        request.auth.uid == userId && (
          isMasterAdmin() || (
            request.resource.data.role == 'STAFF' || request.resource.data.role == 'MASTER_ADMIN'
          )
        ) ||
        isMasterAdmin()
      );
      
      allow update: if isSignedIn() && (
        request.auth.uid == userId && (
          isMasterAdmin() || (
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role) &&
            (!request.resource.data.keys().hasAny(['businessId']) || request.resource.data.businessId == resource.data.businessId) &&
            (!request.resource.data.keys().hasAny(['companyId']) || request.resource.data.companyId == resource.data.companyId)
          )
        ) || 
        isMasterAdmin()
      );
      
      allow delete: if isSignedIn() && isMasterAdmin();
    }

    // =========================================================================
    // PRINCIPLE 5: Non-Repudiation Immutable Logging (Auditing Firewall)
    // Strictly write-once/append-only. Nobody can delete or tamper with audit records.
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.businessId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.businessId == getUserData().businessId ||
          resource.data.businessId == getUserData().companyId ||
          resource.data.companyId == getUserData().businessId ||
          resource.data.companyId == getUserData().companyId
        ))
      );
      
      allow create: if isSignedIn() && (
        isMasterAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.businessId == request.auth.uid ||
        request.resource.data.companyId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          request.resource.data.businessId == getUserData().businessId ||
          request.resource.data.businessId == getUserData().companyId ||
          request.resource.data.companyId == getUserData().businessId ||
          request.resource.data.companyId == getUserData().companyId
        ))
      );
      
      allow update, delete: if false;
    }

    // =========================================================================
    // PRINCIPLE 6: Deep Content & Payload Schema Inspection
    // Enforcing required tenant structures on insertions to block malformed/orphan injections.
    // =========================================================================
    match /{collectionName}/{docId} {
      allow read: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        isMasterAdmin() ||
        resource.data.businessId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.businessId == getUserData().businessId ||
          resource.data.businessId == getUserData().companyId ||
          resource.data.companyId == getUserData().businessId ||
          resource.data.companyId == getUserData().companyId
        ))
      );

      allow create, update: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        (request.resource.data.businessId != '' || request.resource.data.companyId != '') &&
        (
          isMasterAdmin() ||
          request.resource.data.businessId == request.auth.uid ||
          request.resource.data.companyId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            request.resource.data.businessId == getUserData().businessId ||
            request.resource.data.businessId == getUserData().companyId ||
            request.resource.data.companyId == getUserData().businessId ||
            request.resource.data.companyId == getUserData().companyId
          ))
        )
      );

      allow delete: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        isMasterAdmin() ||
        resource.data.businessId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.businessId == getUserData().businessId ||
          resource.data.businessId == getUserData().companyId ||
          resource.data.companyId == getUserData().businessId ||
          resource.data.companyId == getUserData().companyId
        ))
      );
    }
  }
}
