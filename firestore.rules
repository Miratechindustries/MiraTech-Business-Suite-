rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PRINCIPLE 1: Default-Deny Access Control (Zero Trust Firewall)
    // Global lock: explicitly block any unrouted access or wildcard paths. No
    // client can query or read documents unless explicitly allowed in sub-rules.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRINCIPLE 2: Cryptographic Identity & Active Session Validation (Authentication)
    // Ensures that only validated sessions are capable of traversing rules.
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isMiratechEmail() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'miratechindustries@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().email == 'miratechindustries@gmail.com')
      );
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        isMiratechEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'MASTER_ADMIN')
      );
    }

    // =========================================================================
    // PRINCIPLE 3 & 4: Tenant Boundary Isolation & Role-Based Least Privilege (RBAC Engine)
    // Validates that standard administrators can only read/edit their assigned core profiles.
    // =========================================================================
    function isAuthorizedAdminForCompany(companyId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == companyId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          (getUserData().role == 'BUSINESS_ADMIN' || getUserData().role == 'BUSINESS-ADMIN' || getUserData().role == 'BUSINESS ADMIN') && (
            getUserData().businessId == companyId ||
            getUserData().companyId == companyId
          )
        ))
      );
    }

    // =========================================================================
    // PATH SEGMENTATION: Companies & Nested Subcollections
    // =========================================================================
    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.token.email == 'miratechindustries@gmail.com' ||
        request.auth.uid == companyId ||
        isAuthorizedAdminForCompany(companyId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().businessId == companyId ||
          getUserData().companyId == companyId
        ))
      );
      
      allow write: if isAuthorizedAdminForCompany(companyId);
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn() && (
          isMasterAdmin() ||
          request.auth.uid == companyId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            getUserData().businessId == companyId ||
            getUserData().companyId == companyId
          ))
        );
        
        allow write: if isSignedIn() && (
          isMasterAdmin() ||
          request.auth.uid == companyId ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            getUserData().businessId == companyId ||
            getUserData().companyId == companyId
          ))
        );
      }
    }

    match /businesses/{businessId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == businessId ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().businessId == businessId ||
          getUserData().companyId == businessId
        ))
      );
      
      allow write: if isAuthorizedAdminForCompany(businessId);
    }

    // =========================================================================
    // PRINCIPLE 7: Privilege Escalation Prevention & Anti-Tampering (Defense-in-depth)
    // Block standard users from promoting their own security context or changing tenants.
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isMasterAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserData().businessId == resource.data.businessId ||
          getUserData().businessId == resource.data.companyId ||
          getUserData().companyId == resource.data.businessId ||
          getUserData().companyId == resource.data.companyId
        ))
      );
      
      allow create: if isSignedIn() && (
        request.auth.uid == userId && (
          isMasterAdmin() || (
            request.resource.data.role == 'STAFF' || request.resource.data.role == 'MASTER_ADMIN'
          )
        ) ||
        isMasterAdmin()
      );
      
      allow update: if isSignedIn() && (
        request.auth.uid == userId && (
          isMasterAdmin() || (
            (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role) &&
            (!request.resource.data.keys().hasAny(['businessId']) || request.resource.data.businessId == resource.data.businessId) &&
            (!request.resource.data.keys().hasAny(['companyId']) || request.resource.data.companyId == resource.data.companyId)
          )
        ) || 
        isMasterAdmin()
      );
      
      allow delete: if isSignedIn() && isMasterAdmin();
    }

    // =========================================================================
    // PRINCIPLE 5: Non-Repudiation Immutable Logging (Auditing Firewall)
    // Strictly write-once/append-only. Nobody can delete or tamper with audit records.
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (
        isMasterAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.businessId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.businessId == getUserData().businessId ||
          resource.data.businessId == getUserData().companyId ||
          resource.data.companyId == getUserData().businessId ||
          resource.data.companyId == getUserData().companyId
        ))
      );
      
      allow create: if isSignedIn() && (
        isMasterAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.businessId == request.auth.uid ||
        request.resource.data.companyId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          request.resource.data.businessId == getUserData().businessId ||
          request.resource.data.businessId == getUserData().companyId ||
          request.resource.data.companyId == getUserData().businessId ||
          request.resource.data.companyId == getUserData().companyId
        ))
      );
      
      allow update, delete: if false;
    }

    // =========================================================================
    // PRINCIPLE 6: Deep Content & Payload Schema Inspection
    // Enforcing required tenant structures on insertions to block malformed/orphan injections.
    // =========================================================================
    match /{collectionName}/{docId} {
      allow read: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        isMasterAdmin() ||
        resource.data.businessId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.businessId == getUserData().businessId ||
          resource.data.businessId == getUserData().companyId ||
          resource.data.companyId == getUserData().businessId ||
          resource.data.companyId == getUserData().companyId
        ))
      );

      allow create, update: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        (request.resource.data.businessId != '' || request.resource.data.companyId != '') &&
        (
          isMasterAdmin() ||
          request.resource.data.businessId == request.auth.uid ||
          request.resource.data.companyId == request.auth.uid ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            request.resource.data.businessId == getUserData().businessId ||
            request.resource.data.businessId == getUserData().companyId ||
            request.resource.data.companyId == getUserData().businessId ||
            request.resource.data.companyId == getUserData().companyId
          ))
        )
      );

      allow delete: if isSignedIn() && (collectionName in ['products', 'customers', 'expenses', 'notifications', 'general_ledger', 'journal_entries', 'employees', 'payslips']) && (
        isMasterAdmin() ||
        resource.data.businessId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          resource.data.businessId == getUserData().businessId ||
          resource.data.businessId == getUserData().companyId ||
          resource.data.companyId == getUserData().businessId ||
          resource.data.companyId == getUserData().companyId
        ))
      );
    }
  }
}
