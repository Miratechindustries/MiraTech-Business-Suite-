rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'miratechindustries@gmail.com' ||
        request.auth.token.role == 'MASTER_ADMIN'
      );
    }

    function isOwnerOrAdmin(companyId) {
      let userRef = /databases/$(database)/documents/users/$(request.auth.uid);
      return isMasterAdmin() || (
        isSignedIn() &&
        exists(userRef) &&
        get(userRef).data.companyId == companyId &&
        (
          get(userRef).data.role == 'SUPER_ADMIN' ||
          get(userRef).data.role == 'BUSINESS_ADMIN' ||
          get(userRef).data.role == 'COMPANY_OWNER' ||
          get(userRef).data.role == 'COMPANY_ADMIN'
        )
      );
    }

    function getUserCompanyId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId : null;
    }

    function verifyTenant(companyId) {
      return isSignedIn() && (
        isMasterAdmin() ||
        request.auth.uid == companyId ||
        request.auth.token.companyId == companyId ||
        request.auth.token.businessId == companyId ||
        getUserCompanyId() == companyId
      );
    }

    function verifyResourceTenant() {
      let data = resource.data;
      let compId = 'companyId' in data ? data.companyId : ('businessId' in data ? data.businessId : null);
      let userComp = getUserCompanyId();
      return isSignedIn() && (
        isMasterAdmin() ||
        (compId != null && (
          request.auth.uid == compId ||
          request.auth.token.companyId == compId ||
          request.auth.token.businessId == compId ||
          userComp == compId
        ))
      );
    }

    function verifyCreationTenant() {
      let data = request.resource.data;
      let compId = 'companyId' in data ? data.companyId : ('businessId' in data ? data.businessId : null);
      let userComp = getUserCompanyId();
      return isSignedIn() && (
        isMasterAdmin() ||
        (compId != null && (
          request.auth.uid == compId ||
          request.auth.token.companyId == compId ||
          request.auth.token.businessId == compId ||
          userComp == compId
        ))
      );
    }

    // Companies & Subcollections
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isSignedIn() || isMasterAdmin();
      allow update: if isOwnerOrAdmin(companyId) || isMasterAdmin();
      allow delete: if isMasterAdmin();

      // Marketing Module
      match /campaigns/{campaignId} {
        allow read: if verifyTenant(companyId);
        allow create, update: if verifyTenant(companyId) && verifyCreationTenant();
        allow delete: if verifyTenant(companyId) && verifyResourceTenant();
      }
      
      match /leads/{leadId} {
        allow list, read: if verifyTenant(companyId);
        // Master Gate: Leads can only be written if the campaign belongs to the authenticated companyId.
        allow create: if verifyTenant(companyId) && 
                      exists(/databases/$(database)/documents/companies/$(companyId)/campaigns/$(request.resource.data.campaignId));
        allow update, delete: if verifyTenant(companyId);
      }

      // Tasks (Action-Based Updates)
      match /tasks/{taskId} {
        allow read: if verifyTenant(companyId);
        allow create: if verifyTenant(companyId);
        allow update: if verifyTenant(companyId) && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
        allow delete: if verifyTenant(companyId);
      }

      // Projects (Hardened)
      match /projects/{projectId} {
        allow read: if verifyTenant(companyId);
        allow create: if verifyTenant(companyId);
        allow update: if verifyTenant(companyId) && 
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']);
        allow delete: if verifyTenant(companyId);
      }

      match /{subcollection}/{docId} {
        allow read: if verifyTenant(companyId);
        allow create: if verifyTenant(companyId) && verifyCreationTenant();
        allow update: if verifyTenant(companyId) && verifyResourceTenant() && verifyCreationTenant();
        allow delete: if verifyTenant(companyId) && verifyResourceTenant();
      }
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if verifyTenant(businessId) || isMasterAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() || isMasterAdmin();
      allow update: if isSignedIn() || isMasterAdmin();
      allow delete: if isMasterAdmin() || (resource.data.companyId != null && isOwnerOrAdmin(resource.data.companyId));
    }

    // Audit logs (Append only, universal readable for compliance)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }
    match /department_activity_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // System Config & Maintenance (Public read for maintenance mode check, write permissions)
    match /system_config/{docId} {
      allow read, write: if true;
    }

    // Error Logs (Appendable for error reporting, Master Admin manageable)
    match /error_logs/{logId} {
      allow read, write: if true;
    }

    // APM Metrics & Telemetry
    match /apm_metrics/{metricId} {
      allow read, write: if true;
    }

    // Backup History
    match /backup_history/{backupId} {
      allow read, write: if true;
    }

    // Email Preferences Directory (Customer & Tenant Admin Governance)
    match /email_preferences/{prefId} {
      allow read, write: if true;
    }

    // Subscription Transactional Email Events & Idempotency Ledger
    match /subscription_email_events/{eventId} {
      allow read, write: if true;
    }

    // Email Statutory Audit Logs (Universal read/create, Master Admin update/delete)
    match /email_audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isMasterAdmin();
    }

    // Marketing Campaigns (Master Admin & Server Platform Campaign Records)
    match /marketing_campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Legal Documents (Public read for statutory compliance, universal registry write)
    match /legal_documents/{docId} {
      allow read, write: if true;

      match /previous_versions/{versionId} {
        allow read, write: if true;
      }
    }

    // Support Messages (Public client portal submission, tenant or master admin management)
    match /SupportMessages/{msgId} {
      allow read, write: if true;
    }
    match /support_inquiries/{msgId} {
      allow read, write: if true;
    }

    // Paddle Webhook Notifications & Webhook Events
    match /paddle_notifications/{notifId} {
      allow read, write: if true;
    }
    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    // OTP Verifications
    match /otp_verifications/{docId} {
      allow read, write: if true;
    }
    match /_otp_verifications/{docId} {
      allow read, write: if true;
    }

    // Root collections fallback
    match /{collectionName}/{docId} {
      allow read, write: if true;
    }
  }
}
