# .env.example
# Your Google Gemini Developer API Key for AI business insights
GEMINI_API_KEY=

# Brevo (formerly Sendinblue) Transactional Email API Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@miratech.io
BREVO_SENDER_NAME=MiraTech Business Suite Security

# Cryptographic Secret for OTP HMAC Hashing
OTP_SECRET=

# Firebase Admin Service Account Key (JSON string from Firebase Console -> Service Accounts)
# Required on Vercel for serverless Firebase Admin access:
FIREBASE_SERVICE_ACCOUNT_KEY=

# Client Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base URL (e.g. https://your-domain.vercel.app)
NEXT_PUBLIC_BASE_URL=

# Paddle Billing Configuration (Merchant of Record)
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Paddle Price IDs for Subscription Tiers
NEXT_PUBLIC_PADDLE_PRICE_STARTER=pri_starter_tier
NEXT_PUBLIC_PADDLE_PRICE_GROWTH=pri_growth_tier
NEXT_PUBLIC_PADDLE_PRICE_PROFESSIONAL=pri_professional_tier
NEXT_PUBLIC_PADDLE_PRICE_ELITE=pri_elite_tier
NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE=pri_enterprise_tier

